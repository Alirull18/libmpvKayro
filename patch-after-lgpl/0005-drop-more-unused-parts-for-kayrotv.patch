From 838bf25d4ce6255f486eb5612688959ca77a8b0d Mon Sep 17 00:00:00 2001
From: KayroTV <noreply@kayrotv.invalid>
Date: Wed, 25 Nov 2026 05:00:56 +0000
Subject: [PATCH] packages: drop more unused parts for KayroTV

KayroTV embeds mpv through `wid` with the default vo and
hwdec auto|d3d11va|no, so these pieces are never used:

- mpv: -Dsixel=disabled and drop libsixel (terminal sixel output).
- mpv: -Dsubrandr=disabled and drop subrandr. libass still renders
  SRT/ASS/WebVTT. subrandr was only used by mpv.
- FFmpeg: drop --enable-libplacebo and the libplacebo dependency
  (the vf_libplacebo filter). mpv keeps its own libplacebo.
- FFmpeg: drop --enable-cuda-llvm (CUDA filters) and --enable-cuvid
  (separate *_cuvid decoders). nvdec, nvcodec-headers, amf, d3d11va
  and dxva2 are kept.
- FFmpeg: drop --enable-vaapi and the libva dependency. VA-API is
  only usable on Windows with a D3D12 VA driver that is not installed
  by default; mpv's hwdec auto prefers d3d11va.

Vulkan, shaderc, spirv-cross, lcms2, all FFmpeg decoders, demuxers,
parsers, filters and protocols are untouched.
---
 packages/ffmpeg.cmake | 6 ------
 packages/mpv.cmake    | 6 ++----
 2 files changed, 2 insertions(+), 10 deletions(-)

diff --git a/packages/ffmpeg.cmake b/packages/ffmpeg.cmake
index aeaabf0..c24f75e 100644
--- a/packages/ffmpeg.cmake
+++ b/packages/ffmpeg.cmake
@@ -10,9 +10,7 @@ ExternalProject_Add(ffmpeg
         fontconfig
         harfbuzz
         libxml2
-        libplacebo
         dav1d
-        libva
     GIT_REPOSITORY https://github.com/FFmpeg/FFmpeg.git
     SOURCE_DIR ${SOURCE_LOCATION}
     GIT_CLONE_FLAGS "--sparse --filter=tree:0"
@@ -43,12 +41,8 @@ ExternalProject_Add(ffmpeg
         --disable-devices
         --disable-programs
         --disable-doc
-        --enable-libplacebo
-        --enable-cuda-llvm
-        --enable-cuvid
         --enable-nvdec
         --enable-amf
-        --enable-vaapi
         --disable-vdpau
         --disable-videotoolbox
         ${ffmpeg_lto}
diff --git a/packages/mpv.cmake b/packages/mpv.cmake
index 05881e0..417667d 100644
--- a/packages/mpv.cmake
+++ b/packages/mpv.cmake
@@ -11,8 +11,6 @@ ExternalProject_Add(mpv
         shaderc
         libplacebo
         spirv-cross
-        subrandr
-        libsixel
         curl
     GIT_REPOSITORY https://github.com/mpv-player/mpv.git
     SOURCE_DIR ${SOURCE_LOCATION}
@@ -46,8 +44,8 @@ ExternalProject_Add(mpv
         -Dspirv-cross=enabled
         -Dvulkan=enabled
         -Dvapoursynth=disabled
-        -Dsubrandr=enabled
-        -Dsixel=enabled
+        -Dsubrandr=disabled
+        -Dsixel=disabled
         ${mpv_gl}
         -Dlibcurl=enabled
         -Dc_args='-Wno-error=int-conversion'
-- 
